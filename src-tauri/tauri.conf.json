{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Invoice Buddy",
  "version": "0.1.0",
  "identifier": "com.invoicebuddy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Invoice Buddy",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1M0EzMzFCNjkxRTMzQjcKUldTM014NXBHek02WlRtVXhycEVoUVRyUGVOZFVDSUs2WkxpbDFGSWFOKzZMeXp4T1hMWjhaYUwK",
      "endpoints": [
        "https://github.com/clarkeandrew/invoice-buddy/releases/latest/download/latest.json"
      ]
    }
  }
}
